{
  "name": "albertoybelen-operator-staging",
  "main": "backend/staging-operator-entry.js",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": false,
  "preview_urls": false,
  "send_metrics": false,
  "observability": {
    "enabled": false
  },
  "triggers": {
    "crons": []
  },
  "vars": {
    "APP_ENV": "staging-operator-private",
    "STAGING_OPERATOR_ENABLED": "disabled"
  },
  "services": [
    {
      "binding": "STAGING_AUTH_TARGET",
      "service": "albertoybelen-api-staging",
      "entrypoint": "StagingOperatorTarget"
    }
  ]
}
