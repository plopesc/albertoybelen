{
  "name": "albertoybelen-fixture-local",
  "main": "backend/d1/entry.js",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": false,
  "preview_urls": false,
  "vars": {
    "APP_ENV": "local-fixtures"
  },
  "dev": {
    "ip": "127.0.0.1",
    "port": 8788
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "albertoybelen-fixture-local",
      "database_id": "00000000-0000-0000-0000-000000000023",
      "migrations_dir": "backend/d1/migrations",
      "remote": false
    }
  ],
  "send_metrics": false
}
