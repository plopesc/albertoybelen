# Dedicated read-only route. The existing /api/progress and pilot port are untouched.
location = /api/staging/progress {
    if ($host != albertoybelen.ddev.site) { return 404; }
    if ($request_method != GET) { return 405; }
    if ($args != "") { return 400; }
    proxy_pass http://127.0.0.1:8792/api/progress;
    proxy_pass_request_headers off;
    proxy_set_header Host albertoybelen.ddev.site;
    proxy_set_header Content-Length "";
    proxy_pass_request_body off;
    proxy_connect_timeout 2s;
    proxy_read_timeout 8s;
    proxy_hide_header Set-Cookie;
}
