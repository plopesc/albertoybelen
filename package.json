{
  "name": "strava-adventure-prototype",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node --test tests/*.test.js",
    "capture:visual": "node scripts/capture-visuals.mjs",
    "d1:migrate:local": "node scripts/d1-local.mjs migrate",
    "d1:dev:local": "node scripts/d1-local.mjs dev",
    "test:d1": "CLOUDFLARE_SEND_METRICS=false node --test tests/d1/*.test.js",
    "d1:reset:local": "node scripts/reset-d1-local.mjs",
    "oauth:init:mock": "node scripts/oauth-local.mjs init-mock",
    "oauth:migrate:local": "node scripts/oauth-local.mjs migrate",
    "oauth:dev:local": "node scripts/oauth-local.mjs dev",
    "oauth:admin:local": "node scripts/oauth-local.mjs admin",
    "oauth:proxy:enable": "node scripts/oauth-proxy.mjs enable",
    "oauth:proxy:disable": "node scripts/oauth-proxy.mjs disable",
    "test:oauth:browser": "node scripts/check-oauth-browser.mjs"
  },
  "engines": {
    "node": ">=24"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "miniflare": "5.20261110.1-beta",
    "playwright": "1.65.0",
    "wrangler": "4.160.1"
  }
}
